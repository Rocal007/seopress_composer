<?php

namespace SeopressComposer\Services;

/**
 * IconService - Zentraler Dienst für alle SVG-Icons des Themes.
 * Refactored for performance: "True" Lazy Loading using match expression.
 */
class IconService
{
  private static ?IconService $instance = null;

  private function __construct() {}

  public static function getInstance(): IconService
  {
    if (self::$instance === null) {
      self::$instance = new self();
    }
    return self::$instance;
  }

  /**
   * Hauptmethode zum Abrufen eines Icons.
   * @param string $iconName Name des Icons
   * @param array $options ['invert' => bool, 'no_border' => bool, 'size' => 'sm'|'md'|'lg'|'xl']
   */
  public function getIcon(string $iconName, array $options = []): string
  {
    $icon = $this->getIconDefinition($iconName);
    if (empty($icon)) {
        $icon = $this->getIconDefinition('dummy');
    }

    // 1. Illustration Klasse bestimmen
    $innerClass = 'illu';
    if (!empty($options['invert'])) {
      $innerClass = 'illu-invert';
    }
    if (!empty($options['inner_class'])) {
      $innerClass = $options['inner_class'];
    }

    // 2. Rahmen Klasse bestimmen - DEFAULT: KEIN RAHMEN
    $rahmenClass = 'opacity-0 invisible pointer-events-none';
    if (!empty($options['border'])) {
      $rahmenClass = 'rahmen';
    }
    if (!empty($options['primary_background'])) {
      $rahmenClass = 'text-primary fill-current';
    }
    if (!empty($options['secondary_background'])) {
      $rahmenClass = 'text-secondary fill-current';
    }

    // 3. Größe bestimmen
    $sizeClass = '';
    if (!empty($options['size'])) {
      $sizeClass = match ($options['size']) {
        'sm' => ' w-6 h-6',
        'md' => ' w-12 h-12',
        'mdl' => ' w-20 h-20',
        'lg' => ' w-24 h-24',
        'xl' => ' w-32 h-32',
        default => ''
      };
    }

    // Platzhalter ersetzen
    $icon = str_replace(['$rahmen_class', '$illu_class'], [$rahmenClass, $innerClass], $icon);

    // CSS Klasse für die Größe in das <svg> Tag injizieren
    if ($sizeClass) {
      $icon = str_replace('<svg ', '<svg class="' . trim($sizeClass) . '" ', $icon);
    }

    return $icon;
  }

  /**
   * Resolves an icon identifier (URL or Name) and returns the standard HTML.
   * Handles normalization of keys and URL detection.
   */
  public function getIconHtml(string $identifier, string $title = '', array $options = []): string
  {
    if (empty($identifier)) return '';

    $identifier = is_array($identifier) ? ($identifier['url'] ?? '') : $identifier;

    // 1. Check if it's a URL (Image)
    if (filter_var($identifier, FILTER_VALIDATE_URL) || strpos($identifier, '/') !== false) {
      return '<img src="' . esc_url($identifier) . '" class="w-5 h-5 object-contain" alt="' . esc_attr($title) . ' Icon" title="' . esc_attr($title) . '" />';
    }

    // 2. Normalize Key (if it's a name)
    $icon_key = mb_strtolower($identifier);
    $icon_key = str_replace(
      [' ', 'ä', 'ö', 'ü', 'ß'],
      ['_', 'ae', 'oe', 'ue', 'ss'],
      $icon_key
    );
    $icon_key = preg_replace('/[^a-z0-9_]/', '', $icon_key);

    // 3. Get SVG
    // Merge default options - DO NOT force fill-current here if we want to use illu-invert
    $defaultOptions = ['primary_background' => true];
    $finalOptions = array_merge($defaultOptions, $options);

    $svg = $this->getIcon($icon_key, $finalOptions);

    // 4. Return wrapped SVG if valid
    if ($svg && strpos($svg, '<svg') !== false) {
      $wrapperSize = 'w-5 h-5';
      if (!empty($options['size'])) {
        $wrapperSize = match ($options['size']) {
          'sm' => 'w-6 h-6',
          'md' => 'w-10 h-10',
          'lg' => 'w-24 h-24',
          'xl' => 'w-32 h-32',
          default => 'w-5 h-5'
        };
      }

      $classes = $wrapperSize . ' shrink-0 flex items-center justify-center transition-all duration-300';

      // If inverted (Brand Style), the SVG itself has the gold circle background.
      // We don't need to add it again on the wrapper div.

      return '<div class="' . $classes . '">' . $svg . '</div>';
    }

    return '';
  }

