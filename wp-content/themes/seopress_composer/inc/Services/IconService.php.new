  /**
   * Returns the raw SVG definition for a given key.
   * Uses PHP 8 match expression for zero-memory overhead lazy loading.
   */
  private function getIconDefinition(string $key): string
  {
    return match ($key) {
      'dummy' => '<svg aria-hidden="true" role="img" focusable="false" width="100%" height="100%" viewBox="0 0 237 237"><circle class="$rahmen_class" cx="118.5" cy="118.5" r="118" /></svg>',
      'arrow' => '<svg aria-hidden="true" role="img" focusable="false" viewBox="0 0 100 80" width="40" height="40"><rect class="arrow1 text-primary fill-current" x="20" y="10" width="60" height="5"></rect><rect class="arrow2 text-primary fill-current" x="-15" y="75" width="60" height="5"></rect></svg>',
      'drei_punkt' => '<svg aria-hidden="true" role="img" focusable="false" width="100%" height="100%" viewBox="0 0 16 16" fill="currentColor"><path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/></svg>',
